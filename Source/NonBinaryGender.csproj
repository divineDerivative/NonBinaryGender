<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>1.7</Configurations>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <PreBuildEvent>call "$(SolutionDir)..\DivineFramework\PreBuild.bat" "$(ProjectDir)" "$(RootNamespace)"</PreBuildEvent>
    <PostBuildEvent>call "$(SolutionDir)..\DivineFramework\PostBuild.bat" "$(MSBuildProjectName)"</PostBuildEvent>
    <AssemblyTitle>Non-Binary Gender</AssemblyTitle>
    <Description>A RimWorld mod</Description>
    <Product>Non-Binary Gender</Product>
    <Copyright>Copyright © divineDerivative 2023</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='1.7|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <LangVersion>latest</LangVersion>
    <DefineConstants>v1_7</DefineConstants>
  </PropertyGroup>
  <Choose>
    <When Condition="'$(Configuration)|$(Platform)' == '1.7|AnyCPU'">
      <ItemGroup>
        <Reference Include="AlienRace">
          <HintPath>..\..\..\..\..\workshop\content\294100\839005762\1.7\Assemblies\AlienRace.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="PortraitsOfTheRim">
          <HintPath>..\..\..\..\..\workshop\content\294100\2937991425\1.6\Assemblies\PortraitsOfTheRim.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="PawnEditor">
          <HintPath>..\..\..\..\..\workshop\content\294100\3219801790\1.7\Assemblies\PawnEditor.dll</HintPath>
          <Private>False</Private>
        </Reference>
      </ItemGroup>
    </When>
  </Choose>
  <ItemGroup>
    <Reference Include="0DivineFramework">
      <HintPath>..\..\DivineFramework\Assemblies\0DivineFramework.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="FacialAnimation">
      <HintPath>..\..\..\..\..\workshop\content\294100\1635901197\1.4\Assemblies\FacialAnimation.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Patches\ForLater\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4981-unstable" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" />
  </ItemGroup>
  <Target Name="ForcePostBuild" AfterTargets="Build">
    <Touch Files="$(IntermediateOutputPath)TouchMe.txt" />
  </Target>
</Project>